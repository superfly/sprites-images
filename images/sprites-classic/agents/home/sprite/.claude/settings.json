{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__claude_ai_Sprites__",
        "hooks": [
          {
            "type": "command",
            "command": "cat > /dev/null; echo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"permissionDecision\\\":\\\"deny\\\",\\\"permissionDecisionReason\\\":\\\"MCP is not enabled from a Sprite environment, auth and use the sprite CLI or REST API instead\\\"}}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|Write|Edit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.sprite-shared/hooks/sprite-env-check.sh --format claude PostToolUse"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.sprite-shared/hooks/sprite-env-check.sh --format claude UserPromptSubmit"
          }
        ]
      }
    ]
  }
}
